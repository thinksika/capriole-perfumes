// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  brand           String   @default("Capriole")
  price           Float
  compareAtPrice  Float?
  currency        String   @default("GHS")
  volume          String?
  gender          String?  // women, men, unisex
  category        String?  // edp, extrait, samples
  collection      String?
  fragranceFamily String?
  concentration   String?
  description     String?
  shortDescription String?
  topNotes        String?  // JSON array stored as string
  heartNotes      String?
  baseNotes       String?
  mainAccords     String?
  character       String?
  bestFor         String?
  intensity       Int?     // 1-10
  projection      Int?     // 1-10
  longevity       Int?     // 1-10
  freshness       Int?
  sweetness       Int?
  warmth          Int?
  woody           Int?
  spicy           Int?
  images          String?  // JSON array of image paths
  thumbnail       String?
  stockQuantity   Int      @default(0)
  stockStatus     String   @default("in_stock") // in_stock, low_stock, out_of_stock
  featured        Boolean  @default(false)
  bestSeller      Boolean  @default(false)
  newArrival      Boolean  @default(false)
  sampleAvailable Boolean  @default(false)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  discounts       ProductDiscount[]
  orderItems      OrderItem[]
  collectionItems CollectionProduct[]

  @@index([slug])
  @@index([featured])
  @@index([published])
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  philosophy  String?
  image       String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products CollectionProduct[]

  @@index([slug])
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  sortOrder    Int        @default(0)

  @@unique([collectionId, productId])
}

model Discount {
  id          String    @id @default(cuid())
  name        String
  type        String    // percentage, fixed
  value       Float
  scope       String    // product, collection, all
  startDate   DateTime?
  endDate     DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    ProductDiscount[]
}

model ProductDiscount {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  discountId String

  @@unique([productId, discountId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryMethod String      @default("delivery") // delivery, pickup
  address        String?
  city           String?
  region         String?
  notes          String?
  subtotal       Float
  discountAmount Float       @default(0)
  deliveryFee    Float       @default(0)
  total          Float
  status         String      @default("new") // new, contacted, confirmed, preparing, ready_pickup, out_for_delivery, completed, cancelled
  whatsappSent   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  name      String
  price     Float
  quantity  Int
  total     Float
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model JournalPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String?
  coverImage  String?
  author      String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([published])
}

model StoreSettings {
  id                  String   @id @default(cuid())
  businessName        String   @default("Capriole Perfumes")
  tagline             String   @default("The Art of Leaving an Impression.")
  logoUrl             String?
  phone               String   @default("+233547151094")
  whatsappNumber      String   @default("+233547151094")
  instagram           String   @default("@capriole_perfumes.gh")
  website             String   @default("https://www.caprioleperfumes.com")
  address             String   @default("Adabraka, Accra, Ghana")
  googleMapsUrl       String?
  deliveryEnabled     Boolean  @default(true)
  pickupEnabled       Boolean  @default(true)
  deliveryFee         Float?
  freeDeliveryThreshold Float?
  deliveryInstructions String?
  // Store hours stored as JSON string
  storeHours          String   @default("{\"monday\":{\"open\":\"08:30\",\"close\":\"18:00\",\"closed\":false},\"tuesday\":{\"open\":\"08:30\",\"close\":\"18:00\",\"closed\":false},\"wednesday\":{\"open\":\"08:30\",\"close\":\"18:00\",\"closed\":false},\"thursday\":{\"open\":\"08:30\",\"close\":\"18:00\",\"closed\":false},\"friday\":{\"open\":\"08:30\",\"close\":\"18:00\",\"closed\":false},\"saturday\":{\"open\":\"09:00\",\"close\":\"14:00\",\"closed\":false},\"sunday\":{\"open\":null,\"close\":null,\"closed\":true}}")
  updatedAt           DateTime @updatedAt
}

model HomepageConfig {
  id                String   @id @default(cuid())
  heroTitle         String   @default("THE ART OF\nLEAVING AN\nIMPRESSION.")
  heroSubtitle      String   @default("French & Arabian fragrances\nfor moments worth remembering.")
  heroImage         String?
  heroVisible       Boolean  @default(true)
  heroCta1Text      String   @default("SHOP THE COLLECTION")
  heroCta1Url       String   @default("/shop")
  heroCta2Text      String   @default("DISCOVER YOUR SCENT")
  heroCta2Url       String   @default("/discover")
  featuredProductIds String  @default("[]") // JSON array of product IDs
  collectionIds     String   @default("[]")
  updatedAt         DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
